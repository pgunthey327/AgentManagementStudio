{
  "name": "ai-agent-management-studio",
  "displayName": "AI Agent Management Studio",
  "description": "Professional AI agent management and deployment toolkit with custom agent builder",
  "version": "1.0.0",
  "publisher": "accenture-engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/pgunthey327/AgentManagementStudio"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiAgentStudio.installAgents",
        "title": "AI Agents: Install Agent Suite"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/vsce": "^3.9.1"
  }
